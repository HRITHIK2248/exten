{
  "manifest_version": 2,
  "name": "Payment QR Tool",
  "version": "0.9.0",
  "description": "Extract and copy UPI, Pix, and cryptocurrency payment details.",

  "permissions": [
    "activeTab",
    "tabs",
    "<all_urls>",
    "clipboardWrite",
    "storage"
  ],

  "background": {
    "page": "background.html",
    "persistent": true
  },

  "browser_action": {
    "default_title": "Payment QR Tool",
    "default_popup": "popup/popup.html"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "applications": {
    "gecko": {
      "id": "payment-qr-tool@example.local"
    }
  },

  "commands": {
    "scan-qr": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Scan a QR code on the current webpage"
    },

    "snapshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      },
      "description": "Select an area of the current webpage"
    },

    "clear-result": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Clear the latest scan or Snapshot result"
    }
  }
}
